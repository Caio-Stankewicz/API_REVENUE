<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Buscador de Receitas</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <header class="cabecalho-destaque">
    <h1>Buscador de Receitas</h1>
    <p>Encontre a refeição perfeita combinando os ingredientes que você tem em casa.</p>
    
    <form action="/" method="GET" class="formulario-busca">
      <input 
        type="text" 
        name="termo" 
        placeholder="Ex: chicken, garlic, salt..." 
        value="<%= termo %>" 
        required
      >
      <button type="submit">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        Buscar
      </button>
    </form>
  </header>

  <main class="conteiner">
    <% if (pratos.length > 0) { %>
      <div class="grade-receitas">
        <% pratos.forEach(prato => { %>
          <article class="cartao-receita">
            <div class="envoltura-imagem-cartao">
              <img src="<%= prato.imagem %>" alt="<%= prato.nome %>">
            </div>
            <div class="conteudo-cartao">
              <h3><%= prato.nome %></h3>
              <h4>Ingredientes Necessários</h4>
              <ul>
                <% 
                  const palavrasBuscadas = termo.toLowerCase().split(/[,\s]+/).filter(Boolean);
                %>
                <% prato.ingredientes.forEach(item => { %>
                  <% 
                    const isDestacado = palavrasBuscadas.some(p => item.toLowerCase().includes(p)); 
                  %>
                  <li class="<%= isDestacado ? 'destaque' : '' %>"><%= item %></li>
                <% }) %>
              </ul>
            </div>
          </article>
        <% }) %>
      </div>

      <% if (totalPaginas > 1) { %>
        <nav class="paginacao">
          <% if (paginaAtual > 1) { %>
            <a href="/?termo=<%= encodeURIComponent(termo) %>&page=<%= paginaAtual - 1 %>">← Anterior</a>
          <% } %>
          <span>Página <%= paginaAtual %> de <%= totalPaginas %></span>
          <% if (paginaAtual < totalPaginas) { %>
            <a href="/?termo=<%= encodeURIComponent(termo) %>&page=<%= paginaAtual + 1 %>">Próxima →</a>
          <% } %>
        </nav>
      <% } %>

    <% } else if (termo !== '') { %>
      <div class="estado-vazio">
        <span class="icone-vazio">🍽️</span>
        <h2>Nenhuma receita encontrada</h2>
        <p>Não achamos nada com "<strong><%= termo %></strong>". Tente buscar por outros ingredientes em inglês!</p>
      </div>
    <% } %>
  </main>

</body>
</html>