<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>API TheMealDB</title>

  <link
    rel="stylesheet"
    href="/style.css"
  >
</head>

<body>

  <header class="cabecalho">

  <h1>
    Buscador de Receitas
  </h1>

  <p>
    Digite os ingredientes em inglês, separados por vírgula.
  </p>

  <form
    action="/"
    method="GET"
    class="formulario-busca"
  >

    <input
      type="text"
      name="termo"
      placeholder="Ex: egg, sugar, salt"
      value="<%= termo %>"
      required
    >

    <button type="submit">
      Buscar
    </button>

  </form>

</header>


  <main class="conteudo">

    <%
      const ingredientesPesquisados = termo
        .split(',')
        .map(item => item.trim().toLowerCase())
        .filter(Boolean);
    %>


    <% if (receitas.length > 0) { %>

      <section class="grade-receitas">


        <% receitas.forEach(receita => { %>

          <article class="cartao">


            <img
              src="<%= receita.imagem %>"
              alt="<%= receita.nome %>"
            >


            <div class="cartao-conteudo">

              <h2>
                <%= receita.nome %>
              </h2>


              <h3>
                Ingredientes
              </h3>


              <ul>

                <% receita.ingredientes.forEach(ingrediente => { %>

                  <%
                    const selecionado =
                      ingredientesPesquisados.some(item =>
                        ingrediente.nome
                          .toLowerCase()
                          .includes(item)
                      );
                  %>


                  <li
                    class="<%= selecionado ? 'ingrediente-selecionado' : '' %>"
                  >

                    <strong>
                      <%= ingrediente.nome %>
                    </strong>

                    <span>
                      <%= ingrediente.medida %>
                    </span>

                  </li>

                <% }) %>

              </ul>


              <details class="modo-preparo">

                <summary>
                  Ver Modo de Preparo
                </summary>

                <div class="preparo">

                  <p>
                    <%= receita.preparo %>
                  </p>

                </div>

              </details>

            </div>

          </article>

        <% }) %>

      </section>


      <% if (totalPaginas > 1) { %>

        <nav class="paginacao">

          <% if (paginaAtual > 1) { %>

            <a
              href="/?termo=<%= encodeURIComponent(termo) %>&page=<%= paginaAtual - 1 %>"
            >
              ← Previous
            </a>

          <% } %>


          <span>
            Page <%= paginaAtual %> of <%= totalPaginas %>
          </span>


          <% if (paginaAtual < totalPaginas) { %>

            <a
              href="/?termo=<%= encodeURIComponent(termo) %>&page=<%= paginaAtual + 1 %>"
            >
              Next →
            </a>

          <% } %>

        </nav>

      <% } %>


    <% } else if (termo) { %>

      <p class="mensagem">
        Nenhuma receita encontrada.
      </p>

    <% } %>

  </main>

</body>

</html>